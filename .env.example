# Optional server-side newsletter integration. Never prefix these with NEXT_PUBLIC_.
# Point this at an HTTPS mailing-list webhook that accepts {name,email,consent,source}.
NEWSLETTER_WEBHOOK_URL=
# Optional bearer token for that webhook.
NEWSLETTER_WEBHOOK_TOKEN=
# Optional order intake for /checkout. The storefront POSTs re-priced orders here (POS or order system).
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_TOKEN=
# Optional eGift card intake for /gift-cards (payment or gift card provider).
GIFTCARD_WEBHOOK_URL=
GIFTCARD_WEBHOOK_TOKEN=

# Public origin for sitemap, social previews and business structured data.
SITE_URL=https://www.uncorkedhoboken.com
# Orders are requests, not card charges. Provider acknowledgement:
# {accepted:true,reference:"..."}; a nonempty reference also confirms acceptance.
# Gift acknowledgement: {checkoutUrl:"https://..."}, or {issued:true} only
# after payment and gift issuance are confirmed. HTTP 200 alone is insufficient.
# Providers must honor the forwarded Idempotency-Key across server instances
# and deployments. The local five-minute retry cache is not durable storage.
